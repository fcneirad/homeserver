# gateway/Caddyfile — TEMPLATE for the single-port HTTPS gateway.
# Phase 1 pilot: homepage only.
#
# {env.DDNS_HOST} is a template placeholder, NOT a Caddy feature: setup.sh
# renders it from DDNS_HOST in .env into /etc/caddy/Caddyfile. Re-run
# `sudo bash gateway/setup.sh` after changing the hostname.
#
# Router requirement: forward TCP 80 + 443 to this server.
#   - 443: all HTTPS traffic
#   - 80:  Let's Encrypt HTTP-01 validation (Caddy renews automatically)
#
# Adding a service later = add one site block, e.g.:
#   jellyfin.{env.DDNS_HOST} { reverse_proxy 127.0.0.1:8096 }

{env.DDNS_HOST} {
	reverse_proxy 127.0.0.1:8000
}
