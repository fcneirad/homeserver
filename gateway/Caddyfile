# gateway/Caddyfile — single-port HTTPS gateway (Phase 1 pilot: homepage only).
#
# The hostname comes from .env via Caddy's {env.DDNS_HOST} placeholder
# (setup.sh installs a systemd EnvironmentFile drop-in so caddy sees it).
#
# Router requirement: forward TCP 80 + 443 to this server.
#   - 443: all HTTPS traffic
#   - 80:  Let's Encrypt HTTP-01 validation (Caddy renews automatically)
#
# Adding a service later = add one site block, e.g.:
#   jellyfin.{env.DDNS_HOST} { reverse_proxy 127.0.0.1:8096 }

{env.DDNS_HOST} {
	reverse_proxy 127.0.0.1:8000
}
