[Unit]
Description=Homeserver Django application
After=network-online.target
Wants=network-online.target

[Service]
# NOTE: this is a TEMPLATE for the public repo. On the real server, substitute
# the service user and absolute paths (see .env.example: SERVICE_USER).
User=your_user
Group=your_user
WorkingDirectory=/path/to/homeserver/web
Environment=PYTHONUNBUFFERED=1
ExecStart=/path/to/python manage.py runserver 0.0.0.0:80 --noreload
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
