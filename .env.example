# .env.example — copy to .env and fill in. .env is gitignored; never commit it.
# Every machine-specific value used by the setup scripts comes from here, so the
# same repo works on any box (this is what makes migration possible).

# --- Network -------------------------------------------------
# The server's LAN IP (e.g. 192.168.x.x). Used to bind services / build URLs.
SERVER_LAN_IP=
# Public DDNS hostname used for the gateway + Let's Encrypt (no scheme, no path).
DDNS_HOST=

# --- Upstream DNS (Pi-hole) ----------------------------------
PIHOLE_UPSTREAM_1=1.1.1.1
PIHOLE_UPSTREAM_2=9.9.9.9
# Port FTL listens on when a relay is in front of it (WSL2 mirrored mode).
# On native Linux this is 53 and the relay is not used.
PIHOLE_DNS_PORT=1053
# Port for the Pi-hole web UI (kept off 80/443, which belong to the homepage/gateway).
PIHOLE_WEB_PORT=8443

# --- Windows relay (WSL2 mirrored mode only) -----------------
# Where the relay writes its per-device CSV + logs on the Windows host.
RELAY_CSV_PATH=C:\Users\YOUR_USER\dns-relay.csv
RELAY_LOG_DIR=C:\Users\YOUR_USER

# --- Gateway (Caddy + Let's Encrypt) -------------------------
# Required by gateway/setup.sh and the Caddyfile ({env.DDNS_HOST}).
#DDNS_HOST=yourname.ddns.example

# --- Django homepage -----------------------------------------
DJANGO_PORT=80
# Run as this system user (the service unit template substitutes it).
SERVICE_USER=your_user
# Generate with: python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true

# --- Authelia (unified login gate) ---------------------------
# Both are rendered into /etc/authelia/configuration.yml by gateway/setup.sh.
# Generate each with:  openssl rand -hex 32
AUTHELIA_SESSION_SECRET=change-me
AUTHELIA_STORAGE_ENCRYPTION_KEY=change-me
